`timescale 1ns / 1ps

module RegisterFile_tb;
    reg clk, rst, WriteEnable;
    reg [4:0] rs1, rs2, rd;
    reg [31:0] WriteData;
    wire [31:0] ReadData1, ReadData2;

    RegisterFile uut (
        .clk(clk), .rst(rst), .WriteEnable(WriteEnable),
        .rs1(rs1), .rs2(rs2), .rd(rd), .WriteData(WriteData),
        .ReadData1(ReadData1), .ReadData2(ReadData2)
    );

    always #5 clk = ~clk; // 10ns period

    initial begin
        clk = 0; rst = 1; WriteEnable = 0;
        rs1 = 0; rs2 = 0; rd = 0; WriteData = 0;
        #15 rst = 0;

        // i. Write a value to a register and check next clock
        @(posedge clk);
        WriteEnable = 1; rd = 5; WriteData = 32'hDEADBEEF;
        @(posedge clk);
        WriteEnable = 0; rs1 = 5;
        #1 if (ReadData1 == 32'hDEADBEEF) $display("Pass i: Write/Read successful.");

        // ii. Attempt to write to x0 and verify it remains zero
        @(posedge clk);
        WriteEnable = 1; rd = 0; WriteData = 32'hFFFFFFFF;
        @(posedge clk);
        WriteEnable = 0; rs1 = 0;
        #1 if (ReadData1 == 32'h00000000) $display("Pass ii: x0 write ignored.");

        // iii. Simultaneous two read ports
        @(posedge clk);
        WriteEnable = 1; rd = 6; WriteData = 32'h12345678;
        @(posedge clk);
        WriteEnable = 0; rs1 = 5; rs2 = 6;
        #1 if (ReadData1 == 32'hDEADBEEF && ReadData2 == 32'h12345678) $display("Pass iii: Simultaneous reads successful.");

        // iv. Overwrite a register and verify replacement
        @(posedge clk);
        WriteEnable = 1; rd = 5; WriteData = 32'hCAFEBAbe;
        @(posedge clk);
        WriteEnable = 0; rs1 = 5;
        #1 if (ReadData1 == 32'hCAFEBAbe) $display("Pass iv: Overwrite successful.");

        // v. Reset behavior
        @(posedge clk);
        rst = 1;
        @(posedge clk);
        rst = 0; rs1 = 5;
        #1 if (ReadData1 == 32'b0) $display("Pass v: Reset successful.");

        #20 $finish;
    end
endmodule
